(defwindow dock
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "4px"
                               :width "99.1%"
                               :height "0"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           :windowtype "dock"
           :namespace "eww"
           :css "background: transparent;"
  (bar))

(defwidget bar []
  (centerbox :class "bar propo-font" 
             :orientation "h"
    (leftside)
    ;(button :onclick "eww open --toggle center_window-closer && eww open --toggle center_window && eww update reveal_center=${!reveal_center}"
    (box :space-evenly false :spacing 8
      (button :onclick "eww open --toggle center_window && eww update reveal_center=${!reveal_center}"
        {formattime(EWW_TIME, "%a %d %b,")})
      (button :onclick "eww open --toggle worldclocks"
        {formattime(EWW_TIME, "%I:%M %p")})
    )
    (rightside)))

(defwidget leftside []
  (box :class "leftside"
       :halign "start"
       :vexpand true
       :hexpand true
    :space-evenly false
    (button :class "archbtn" :onclick "eww open --toggle sysmenu && eww update reveal_left=${!reveal_left}" "")
       ;(button :class "archbtn" :onclick "eww open --toggle sysmenu-closer && eww open --toggle sysmenu && eww update reveal_left=${!reveal_left}" " ")
        "|" ;"│"
       (workspaces)
))

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "start"
       :spacing 2
  (for entry in workspaces
    (button :onclick "niri msg action focus-workspace ${entry.idx}"
          {entry.is_focused ? " " : " " }))
))

(defwidget rightside []
  (box :class "rightside" :orientation "h" :space-evenly false :halign "end"
    (box :class "metrices"
    (box :class "metricbox" "  ${volume}%")
    (box :class "metricbox" "  ${round(EWW_RAM.used_mem_perc, 0)}%")
    (box :class "metricbox" "  ${round(EWW_CPU.avg, 0)<10 ? "0${round(EWW_CPU.avg, 0)}" : round(EWW_CPU.avg, 0)}%" )
    )
    "|"
    (button :onclick "swaync-client -t" :class "notifbtn" "  ") ;󱥁  
  )
)

(deflisten volume :initial 70
  `scripts/getvol`)
(deflisten workspaces :initial "[]"
  `scripts/workspaces`)

(defwidget metric [label value onchange ?maxv]
  (box :orientation "h"
       :class "metric"
       :space-evenly false
    (box :class "label" label)
    (scale :min 0
           :max {maxv ?: 101}
           :active {onchange != ""}
           :value {value ?: 5}
           :onchange onchange)))

