(include "./dock/eww.yuck")
(include "./sysmenu/eww.yuck")
(include "./misc/eww.yuck")

(defwidget closer [window ?updatevar]
  (eventbox :onclick "${updatevar} eww close ${window} && eww close ${window}-closer"))
 
(defwindow center_window-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "center_window" :updatevar "eww update reveal_center=false &&"))

(defwindow sysmenu-closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (closer :window "sysmenu" :updatevar "eww update reveal_left=false &&"))
