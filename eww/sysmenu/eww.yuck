(defvar reveal_left false)
(defpoll uptime :interval "60s" :initial "1 minute" :run-while reveal_left 
  `uptime -p`)
(defpoll weather_info :initial "{}" :interval "1h" :run-while reveal_left
`scripts/getweather`)
;(defvar weather_info '{"temp":"30°C","phrase":"Clear","realfeel":"28","realfeel2":"","humidity":"18","weathercode":"33","imagepath":"/home/xylo/dev/nodejs/weather_scraper/weatherpngs/33.png"}')

(defwindow sysmenu
           :monitor 0
           :geometry (geometry :x "0.6%"
                               :y "1%"
                               :width "0" ;"25%"
                               :height "0" ; "80%"
                               :anchor "top left")
           :stacking "fg"
           :windowtype "dock"
           :css "background: transparent;"
  (menu))
  ;(revealer :transition "crossfade" :duration "200ms" :reveal reveal_left (menu)))

(defwidget menu []
  (box :class "main-menu"
    :width 330
    :orientation "v"
    :space-evenly false
    :spacing 10
    :vexpand true
    (box :orientation "h" :space-evenly false :spacing 10
      (profile)
      (power_options)
    )
    ;(box :orientation "v" :space-evenly false :class "weather-box" 
      ;(box :halign "start" "Weather")
      (weather)
    ;)
    (settings)
    ;(box :orientation "h" :spacing 8
      ;(apps)
      ;(tools)
    ;)
  )
)

(defwidget weather [] 
  (box :class "weather propo-font" :orientation "h" :space-evenly false :spacing 12
    (image :class "weather-icon"
      :path "${weather_info["imagepath"]}"
      :image-width 65
      :image-height 65
    )
    (box :class "temp-icon"
      "")
    (box :class "col1" :orientation "v" :space-evenly false :valign "center" :spacing 0
      (box :class "weather-temp"
        `${weather_info["temp"]}`
      )
      (box :class "weather-phrase"
        `${weather_info["phrase"]}`
      )
    )
    (box :class "col2" :orientation "v" :space-evenly false :valign "center" :spacing 5
      (box :class "realfeel" :halign "start"
        `  ${weather_info["realfeel"]}°C`
      )
      (box :class "humidity" :halign "start"
        `  ${weather_info["humidity"]}%`
      )
    )
  )
)

(defwidget profile []
  (box :class "profile propo-font" :orientation "v" :space-evenly false 
    :halign "fill"
    (box :class "pfp" :width 100 :height 100 :halign "center")
    (box :class "profile-description" :orientation "v" :space-evenly true 
      (box :class "profile-username" "Xyloflare")
      (box :class "system-uptime" "  ${uptime}")
    )
  )
)

(defwidget settings []
  (box :class "btns symbols-font" :orientation "h" :space-evenly true 
    :spacing 10 
    (button :class "wifi" "󰤨")
    (button :class "bluetooth" "")
    (button :class "dnd" "󰂛")
  )
)

(defwidget power_options []
  (box :class "btns power-options symbols-font" :orientation "v" :space-evenly true 
    :halign "end" :spacing 8
    ;:spacing 10 :width 70 :halign "end" :valign "fill"
    (button :onclick "" :class "poweroff" "") ;
    (button :onclick "" :class "restart" "") ;󱍸 󰜉   
    (button :onclick "" :class "lock" "") ;
    (button :onclick "" :class "logout" "") ;󰊳 
    (button :onclick "" :class "sleep" "󰤄")
  )
)

(defwidget apps []
  (box :class "apps btns symbols-font" :orientation "v" :spacing 8
    (box :class "row1" :orientation "h" :spacing 8
      (button :class "" :class "brave" "") ;
      (button :class "" :class "discord" "") ;󰙯
    )
    (box :class "row2" :orientation "h" :spacing 8
      (button :onclick "" :class "terminal" "") ;
      (button :onclick "" :class "yazi" "") ;
    )
  )
)

(defwidget tools []
  (box :class "tools btns symbols-font" :orientation "v" :spacing 8
    (box :class "row1" :orientation "h" :spacing 8
      (button :onclick "" :class "color-picker" "󰃉")
      (button :onclick "" :class "screen-capture" "󱣴") ;
    )
    (box :class "row2" :orientation "h" :spacing 8
      (button :onclick "" :class "wallpaper" "󰋩") ;󰸉
      (button :onclick "" :class "theme-selector" "") ;
    )
  )
)









